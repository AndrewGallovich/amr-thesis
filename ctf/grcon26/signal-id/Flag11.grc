- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nMARK = 0xA6C6AAAA\
      \          # middle of the FLEX frame marker\nSYNC2_BITS = 40            # 25\
      \ ms of filler after the frame header (at 1600 bits/s)\nDATA_BITS = 88 * 32\
      \        # 11 blocks x 8 words x 32 bits\nNUMERIC = '0123456789 U -]['\n\n\n\
      class blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='FLEX pager decoder',\n            in_sig=[np.uint8],\
      \   # one 0/1 per bit (1600 bits/s), from the Binary Slicer\n            out_sig=None\
      \         # prints to the console\n        )\n        self.reg = 0         \
      \    # last 64 bits, to spot the frame marker\n        self.state = 'hunt'\n\
      \        self.invert = 0\n        self.count = 0\n        self.words = [0] *\
      \ 88\n\n    def work(self, input_items, output_items):\n        for b in input_items[0]:\n\
      \            b = int(b)\n            if self.state == 'hunt':\n            \
      \    # Step 1: find the frame marker (or its flipped version)\n            \
      \    self.reg = ((self.reg << 1) | b) & 0xFFFFFFFFFFFFFFFF\n               \
      \ mid = (self.reg >> 16) & 0xFFFFFFFF\n                if mid in (MARK, MARK\
      \ ^ 0xFFFFFFFF):\n                    self.invert = 0 if mid == MARK else 1\n\
      \                    self.state = 'skip'\n                    self.count = 16\
      \ + 32 + SYNC2_BITS   # 16 filler + frame info word + filler\n            elif\
      \ self.state == 'skip':\n                self.count -= 1\n                if\
      \ self.count == 0:\n                    self.state = 'data'\n              \
      \      self.words = [0] * 88\n            else:\n                # Step 2: un-shuffle\
      \ the bits. Each block of 256 bits holds 8 words,\n                # sent one\
      \ bit from each word in turn (\"interleaving\").\n                bit = b ^\
      \ self.invert ^ 1   # data bits use the opposite sense to the marker\n     \
      \           c = self.count\n                word = (c >> 8) * 8 + (c & 7)\n\
      \                pos = (c >> 3) & 31\n                self.words[word] |= bit\
      \ << pos        # first bit sent = smallest bit\n                self.count\
      \ += 1\n                if self.count == DATA_BITS:\n                    self.decode([w\
      \ & 0x1FFFFF for w in self.words])  # keep 21 data bits\n                  \
      \  self.state = 'hunt'\n                    self.reg = 0\n        return len(input_items[0])\n\
      \n    # Step 3: read the frame's table of contents, then each message\n    def\
      \ decode(self, w):\n        biw = w[0]                             # first word:\
      \ where things are\n        if biw in (0, 0x1FFFFF):\n            return\n \
      \       aoffset = ((biw >> 8) & 0x3) + 1       # where the addresses start\n\
      \        voffset = (biw >> 10) & 0x3F           # where the \"vectors\" start\n\
      \        if not aoffset < voffset <= 88:\n            return\n        for i\
      \ in range(aoffset, voffset):\n            j = voffset + (i - aoffset)     \
      \   # each address has a matching vector\n            if j >= 88:\n        \
      \        break\n            addr = w[i] - 0x8000               # pager number\n\
      \            vec = w[j]\n            kind = (vec >> 4) & 0x7            # 5\
      \ = letters, 3/4/7 = digits\n            start = (vec >> 7) & 0x7F         \
      \ # where the message words are\n            length = (vec >> 14) & 0x7F\n \
      \           msg = w[start:start + length]\n            if not msg:\n       \
      \         continue\n            # Letters: 3 x 7 bits per word. Digits: 4 bits\
      \ each.\n            letters = ''.join(chr((m >> s) & 0x7F) for m in msg for\
      \ s in (0, 7, 14))\n            letters = ''.join(c for c in letters if 32 <=\
      \ ord(c) < 127)\n            bits = ''.join(format(m, '021b')[::-1] for m in\
      \ msg)\n            digits = ''.join(NUMERIC[int(bits[k:k + 4][::-1], 2)]\n\
      \                             for k in range(0, len(bits) - 3, 4))\n       \
      \     print(f\"Pager {addr} (type {kind}):\", flush=True)\n            print(f\"\
      \   as letters: {letters}\", flush=True)\n            print(f\"   as digits:\
      \  {digits.strip()}\", flush=True)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('FLEX pager decoder', 'blk', [], [('0', 'byte', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1840, 344.0]
    rotation: 0
    state: enabled
