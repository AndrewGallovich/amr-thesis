- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n# ---------- M17\
      \ building blocks ----------\nRAND = [0xD6,0xB5,0xE2,0x30,0x82,0xFF,0x84,0x62,0xBA,0x4E,0x96,0x90,0xD8,0x98,0xDD,0x5D,\n\
      \        0x0C,0xC8,0x52,0x43,0x91,0x1D,0xF8,0x6E,0x68,0x2F,0x35,0xDA,0x14,0xEA,0xCD,0x76,\n\
      \        0x19,0x8D,0xD5,0x80,0xD1,0x33,0x87,0x13,0x57,0x18,0x2D,0x29,0x78,0xC3]\n\
      RAND_BITS = [(RAND[i // 8] >> (7 - i % 8)) & 1 for i in range(368)]   # \"scrambler\"\
      \ pattern\nSHUFFLE = [(45 * i + 92 * i * i) % 368 for i in range(368)]     \
      \      # interleaver order\nP1 = [1] + [1, 0, 1, 1] * 15        # which coded\
      \ bits were kept (setup frame)\nP3 = [1, 1, 1, 1, 1, 1, 1, 0]       # which\
      \ coded bits were kept (packet frames)\nSYNC_LSF = [int(c) for c in '0101010111110111']\
      \   # 0x55F7: \"setup frame next\"\nSYNC_PKT = [int(c) for c in '0111010111111111']\
      \   # 0x75FF: \"packet frame next\"\n\n\ndef unscramble(bits):\n    bits = [b\
      \ ^ r for b, r in zip(bits, RAND_BITS)]   # undo the scrambler\n    out = [0]\
      \ * 368\n    for i in range(368):                              # undo the shuffle\n\
      \        out[SHUFFLE[i]] = bits[i]\n    return out\n\n\ndef fill_gaps(bits,\
      \ pattern, total):\n    \"\"\"Put back the bits the sender dropped, as 'unknown'\
      \ (None).\"\"\"\n    out, k, i = [], 0, 0\n    while len(out) < total:\n   \
      \     if pattern[i % len(pattern)]:\n            out.append(bits[k] if k < len(bits)\
      \ else None)\n            k += 1\n        else:\n            out.append(None)\n\
      \        i += 1\n    return out\n\n\ndef viterbi(coded):\n    \"\"\"Undo the\
      \ error-correcting code: find the input bits that best explain what we got.\"\
      \"\"\n    def encode(state, b):\n        r = (b << 4) | state\n        g1 =\
      \ ((r >> 4) ^ (r >> 1) ^ r) & 1\n        g2 = ((r >> 4) ^ (r >> 3) ^ (r >> 2)\
      \ ^ r) & 1\n        return g1, g2, (r >> 1) & 0xF\n    INF = 10 ** 9\n    cost\
      \ = [0] + [INF] * 15\n    paths = [[] for _ in range(16)]\n    for t in range(0,\
      \ len(coded), 2):\n        c1, c2 = coded[t], coded[t + 1]\n        new_cost,\
      \ new_paths = [INF] * 16, [None] * 16\n        for s in range(16):\n       \
      \     if cost[s] >= INF:\n                continue\n            for b in (0,\
      \ 1):\n                g1, g2, ns = encode(s, b)\n                c = cost[s]\
      \ + (c1 is not None and c1 != g1) + (c2 is not None and c2 != g2)\n        \
      \        if c < new_cost[ns]:\n                    new_cost[ns], new_paths[ns]\
      \ = c, paths[s] + [b]\n        cost, paths = new_cost, new_paths\n    best =\
      \ min(range(16), key=lambda s: cost[s])\n    return paths[best], cost[best]\n\
      \n\ndef crc16(data):\n    crc = 0xFFFF\n    for byte in data:\n        crc ^=\
      \ byte << 8\n        for _ in range(8):\n            crc = ((crc << 1) ^ 0x5935)\
      \ & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF\n    return crc\n\n\ndef\
      \ to_bytes(bits):\n    return bytes(int(''.join(map(str, bits[i:i + 8])), 2)\
      \ for i in range(0, len(bits) - 7, 8))\n\n\n# ---------- the GNU Radio block\
      \ ----------\nclass blk(gr.sync_block):\n    def __init__(self, threshold=0.40):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='M17 packet\
      \ decoder',\n            in_sig=[np.float32],   # one value per symbol, from\
      \ Symbol Sync\n            out_sig=None\n        )\n        self.threshold =\
      \ threshold   # between the inner and outer frequency levels\n        self.bits\
      \ = []               # recent bits, to spot the sync words\n        self.mode\
      \ = 'hunt'\n        self.frame = []\n        self.packet = b''\n        self.last_printed\
      \ = None\n\n    def work(self, input_items, output_items):\n        for x in\
      \ input_items[0]:\n            # Step 1: four frequency levels -> 2 bits each\n\
      \            if x > self.threshold:\n                pair = (0, 1)        #\
      \ +3\n            elif x > 0:\n                pair = (0, 0)        # +1\n \
      \           elif x > -self.threshold:\n                pair = (1, 0)       \
      \ # -1\n            else:\n                pair = (1, 1)        # -3\n     \
      \       for b in pair:\n                self.push(b)\n        return len(input_items[0])\n\
      \n    def push(self, b):\n        if self.mode == 'hunt':\n            # Step\
      \ 2: look for a sync word\n            self.bits = (self.bits + [b])[-16:]\n\
      \            if self.bits == SYNC_LSF:\n                self.mode, self.frame,\
      \ self.packet = 'lsf', [], b''\n            elif self.bits == SYNC_PKT:\n  \
      \              self.mode, self.frame = 'pkt', []\n            return\n     \
      \   # Step 3: collect one frame (368 bits)\n        self.frame.append(b)\n \
      \       if len(self.frame) < 368:\n            return\n        frame, mode =\
      \ self.frame, self.mode\n        self.mode, self.bits = 'hunt', []\n       \
      \ if mode == 'lsf':\n            return                   # setup frame: callsigns\
      \ etc. (not needed for the text)\n        # Step 4: unscramble, un-shuffle,\
      \ refill dropped bits, undo error correction\n        dec, errors = viterbi(fill_gaps(unscramble(frame),\
      \ P3, 420))\n        if errors > 20:\n            self.packet = b''\n      \
      \      return\n        data = to_bytes(dec[:200])               # 25 bytes of\
      \ the message\n        last = dec[200]                          # 1 = this is\
      \ the last frame\n        count = int(''.join(map(str, dec[201:206])), 2)\n\
      \        if not last:\n            self.packet += data\n            return\n\
      \        self.packet += data[:count]              # last frame: only 'count'\
      \ bytes are real\n        # Step 5: check the whole message, then print it\n\
      \        msg, self.packet = self.packet, b''\n        if len(msg) < 3 or crc16(msg[:-2])\
      \ != int.from_bytes(msg[-2:], 'big'):\n            return\n        text = msg[1:-2].rstrip(b'\\\
      x00').decode('ascii', errors='replace')   # byte 0 = message type\n        if\
      \ text != self.last_printed:\n            print(f\"M17 message (type {msg[0]}):\
      \ {text}\", flush=True)\n            self.last_printed = text"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold: '0.40'
  states:
    _io_cache: ('M17 packet decoder', 'blk', [('threshold', '0.4')], [('0', 'float',
      1)], [], '', ['threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1848, 280.0]
    rotation: 0
    state: enabled
