- name: rds_text
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRDS text decoder (replaces gr-rds RDS Decoder + RDS Parser).\n\
      \nInput: one bit per byte (0 or 1), straight from the Differential Decoder.\n\
      Prints the station name (PS) and RadioText (RT) to the console whenever they\
      \ change.\n\nHow it works:\n  RDS sends data in \"groups\" of 4 blocks (A, B,\
      \ C, D), 26 bits each = 104 bits.\n  Each block = 16 data bits + 10 check bits.\
      \ The check bits are mixed with a\n  known \"offset word\" that is different\
      \ for A, B, C and D. So by checking the\n  last 104 bits, we can tell when a\
      \ full group has just arrived.\n  Block B says what kind of group it is:\n \
      \   type 0A -> 2 characters of the station name (PS, 8 chars total)\n    type\
      \ 2A -> 4 characters of RadioText (RT, up to 64 chars)\n\"\"\"\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\nPOLY = 0x5B9                           \
      \   # RDS check polynomial (x^10+x^8+x^7+x^5+x^4+x^3+1)\nOFFSETS = {0x0FC: 'A',\
      \ 0x198: 'B', 0x168: 'C', 0x350: 'C', 0x1B4: 'D'}\n\n\ndef syndrome(word26):\n\
      \    \"\"\"Remainder of a 26-bit block divided by the RDS polynomial.\"\"\"\n\
      \    r = word26\n    for i in range(25, 9, -1):\n        if r >> i & 1:\n  \
      \          r ^= POLY << (i - 10)\n    return r\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(self, name='RDS text\
      \ decoder', in_sig=[np.uint8], out_sig=None)\n        self.window = 0      \
      \             # last 104 bits, newest bit at the right\n        self.nbits =\
      \ 0\n        self.ps = [' '] * 8\n        self.rt = [' '] * 64\n        self.last_print\
      \ = ''\n\n    def work(self, input_items, output_items):\n        for b in input_items[0]:\n\
      \            self.window = ((self.window << 1) | int(b & 1)) & ((1 << 104) -\
      \ 1)\n            self.nbits += 1\n            if self.nbits >= 104:\n     \
      \           self.check_group()\n        return len(input_items[0])\n\n    def\
      \ check_group(self):\n        blocks = [(self.window >> (26 * (3 - k))) & 0x3FFFFFF\
      \ for k in range(4)]\n        names = [OFFSETS.get(syndrome(w)) for w in blocks]\n\
      \        if names != ['A', 'B', 'C', 'D']:\n            return\n        a, b,\
      \ c, d = [w >> 10 for w in blocks]   # keep the 16 data bits\n        group_type,\
      \ version = b >> 12, (b >> 11) & 1\n        if group_type == 0:            \
      \           # station name\n            i = b & 3\n            self.ps[2 * i:2\
      \ * i + 2] = [chr(d >> 8), chr(d & 0xFF)]\n        elif group_type == 2 and\
      \ version == 0:    # RadioText\n            i = b & 15\n            self.rt[4\
      \ * i:4 * i + 4] = [chr(c >> 8), chr(c & 0xFF), chr(d >> 8), chr(d & 0xFF)]\n\
      \        text = 'PS: [%s]   RT: [%s]' % (''.join(self.ps), ''.join(self.rt).split('\\\
      r')[0].rstrip())\n        if text != self.last_print:\n            print(text,\
      \ flush=True)\n            self.last_print = text\n"
    affinity: ''
    alias: ''
    comment: 'Step 8: bits -> text (prints to console)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('RDS text decoder', 'blk', [], [('0', 'byte', 1)], [], '', [])
