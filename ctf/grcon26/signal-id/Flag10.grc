- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nSYNC = 0x7CD215D8\
      \   # \"a batch starts here\" marker\nIDLE = 0x7A89C197   # \"nothing to send\"\
      \ filler\nMASK = 0xFFFFFFFF\nNUMERIC = '0123456789.U -)('   # pager digits (4\
      \ bits each)\n\n\nclass blk(gr.sync_block):\n    def __init__(self):\n     \
      \   gr.sync_block.__init__(\n            self,\n            name='Pager (POCSAG)\
      \ decoder',\n            in_sig=[np.uint8],   # one 0/1 per bit, from the Binary\
      \ Slicer\n            out_sig=None         # prints to the console\n       \
      \ )\n        self.reg = 0             # last 32 bits, used to spot the marker\n\
      \        self.synced = False      # inside a batch?\n        self.invert = False\
      \      # 0s and 1s flipped?\n        self.word = 0            # current 32-bit\
      \ word being collected\n        self.nbits = 0\n        self.count = 0     \
      \      # words read in this batch (16 per batch)\n        self.addr = None \
      \        # who the current message is for\n        self.func = 0\n        self.msg_bits\
      \ = []       # message bits collected so far\n\n    def work(self, input_items,\
      \ output_items):\n        for b in input_items[0]:\n            b = int(b)\n\
      \            if not self.synced:\n                # Step 1: look for the marker\
      \ (or its flipped version)\n                self.reg = ((self.reg << 1) | b)\
      \ & MASK\n                if self.reg in (SYNC, SYNC ^ MASK):\n            \
      \        self.invert = self.reg != SYNC\n                    self.start_batch()\n\
      \                continue\n\n            # Step 2: collect 32-bit words\n  \
      \          self.word = (self.word << 1) | (b ^ self.invert)\n            self.nbits\
      \ += 1\n            if self.nbits < 32:\n                continue\n        \
      \    word, self.word, self.nbits = self.word, 0, 0\n\n            if self.count\
      \ == 16:             # a batch is 16 words, then a new marker\n            \
      \    if word == SYNC:\n                    self.count = 0\n                else:\
      \                        # transmission ended\n                    self.flush()\n\
      \                    self.synced = False\n                    self.reg = 0\n\
      \                continue\n\n            self.handle(word, self.count // 2)\n\
      \            self.count += 1\n        return len(input_items[0])\n\n    def\
      \ start_batch(self):\n        self.synced = True\n        self.word = 0\n  \
      \      self.nbits = 0\n        self.count = 0\n\n    # Step 3: each word is\
      \ either an address, message data, or filler\n    def handle(self, word, frame):\n\
      \        if word == IDLE:\n            self.flush()\n        elif word >> 31\
      \ == 0:                # first bit 0 = address\n            self.flush()\n \
      \           self.addr = (((word >> 13) & 0x3FFFF) << 3) | frame\n          \
      \  self.func = (word >> 11) & 0x3\n            self.msg_bits = []\n        else:\
      \                                # first bit 1 = 20 bits of message\n      \
      \      data = (word >> 11) & 0xFFFFF\n            self.msg_bits += [(data >>\
      \ (19 - i)) & 1 for i in range(20)]\n\n    # Step 4: message bits -> text (letters\
      \ are 7 bits, digits 4 bits)\n    def flush(self):\n        if self.addr is\
      \ None:\n            return\n        bits = self.msg_bits\n        letters =\
      \ ''.join(\n            chr(sum(bits[i + k] << k for k in range(7)))\n     \
      \       for i in range(0, len(bits) - 6, 7))\n        letters = ''.join(c for\
      \ c in letters if 32 <= ord(c) < 127)\n        digits = ''.join(\n         \
      \   NUMERIC[sum(bits[i + k] << k for k in range(4))]\n            for i in range(0,\
      \ len(bits) - 3, 4))\n        print(f\"Pager {self.addr} (type {self.func}):\"\
      , flush=True)\n        print(f\"   as letters: {letters}\", flush=True)\n  \
      \      print(f\"   as digits:  {digits.strip()}\", flush=True)\n        self.addr\
      \ = None\n        self.msg_bits = []"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Pager (POCSAG) decoder', 'blk', [], [('0', 'byte', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1888, 352.0]
    rotation: 0
    state: enabled
